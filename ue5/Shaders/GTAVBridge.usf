// The picture the game gets (GTAVBridgeShaders.h): the scene colour (after motion blur: HDR, before bloom and tone
// mapping), and in alpha the depth at that pixel in metres along the view (the depth is at the render resolution, in
// the view's own rectangle; the colour at the output's).
#include "/Engine/Private/Common.ush"

Texture2D SceneColor;
Texture2D SceneDepth;
int2 ColorMin;
int2 ColorSize;

void MainPS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const int2 P = int2(SvPosition.xy);
	const float3 Color = SceneColor.Load(int3(P + ColorMin, 0)).rgb;
	const int2 DepthMin = int2(View.ViewRectMinAndSize.xy), DepthSize = int2(View.ViewRectMinAndSize.zw);
	const int2 Q = clamp(DepthMin + int2((float2(P) + 0.5) * float2(DepthSize) / float2(ColorSize)), DepthMin, DepthMin + DepthSize - 1);
	const float DeviceZ = SceneDepth.Load(int3(Q, 0)).r;
	const float Metres = DeviceZ > 0 ? ConvertFromDeviceZ(DeviceZ) * 0.01 : 65504.0;
	OutColor = float4(Color, min(Metres, 65504.0));
}
